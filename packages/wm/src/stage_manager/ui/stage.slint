// Stage Manager card panel UI.
//
// Rendered by the `stage_manager` module in a dedicated thread. All state is
// pushed through the `Stage` global by the host (Rust) side.

export struct StageCard {
    title: string,
    thumb: image,
    initial: string,
    has-thumb: bool,
    icon: image,
    has-icon: bool,
}

export global Stage {
    in property <[StageCard]> cards;
    in property <length> card-width: 216px;
    in property <length> card-height: 148px;
    in property <length> spacing: 10px;
    in property <length> corner: 12px;
    in property <float> card-opacity: 0.92;
    in property <string> status: "";

    callback card-clicked(int);
    callback card-hovered(int);
}

export component StagePanel inherits Window {
    title: "GlazeWM Stage";
    no-frame: true;
    background: transparent;
    always-on-top: true;

    VerticalLayout {
        padding: 12px;
        spacing: Stage.spacing;
        alignment: start;

        for card[idx] in Stage.cards: Rectangle {
            height: Stage.card-height;
            border-radius: Stage.corner;
            clip: true;

            // Soft drop shadow to separate the card from dark wallpapers.
            drop-shadow-offset-y: 4px;
            drop-shadow-blur: 12px;
            drop-shadow-color: rgba(0, 0, 0, 0.55);

            // Card background.
            Rectangle {
                background: rgba(28, 28, 33, Stage.card-opacity);
            }

            // Thumbnail of the window.
            if card.has-thumb: Image {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height - 36px;
                source: card.thumb;
            }

            // Fallback when no thumbnail is available: the app icon
            // centered on a flat dark fill, or the title's initial when
            // the icon capture failed too.
            if !card.has-thumb: Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height - 36px;
                background: rgba(34, 34, 40, 1);

                if card.has-icon: Image {
                    width: min(64px, parent.height - 24px);
                    height: self.width;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: card.icon;
                }

                if !card.has-icon: Text {
                    text: card.initial;
                    font-size: 30px;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Title bar at the bottom of the card.
            Rectangle {
                y: parent.height - 36px;
                height: 36px;
                width: parent.width;
                background: rgba(0, 0, 0, 0.55);

                if card.has-icon: Image {
                    x: 8px;
                    y: (parent.height - 28px) / 2;
                    width: 28px;
                    height: 28px;
                    source: card.icon;
                }

                Text {
                    x: card.has-icon ? 44px : 8px;
                    width: parent.width - self.x - 8px;
                    height: parent.height;
                    vertical-alignment: center;
                    text: card.title;
                    color: white;
                    font-size: 14px;
                    overflow: elide;
                }
            }

            // Permanent hairline border; brightens into the hover highlight.
            Rectangle {
                border-width: ta.has-hover ? 2px : 1px;
                border-color: ta.has-hover ? rgba(255, 255, 255, 0.65) : rgba(255, 255, 255, 0.35);
                border-radius: Stage.corner;
            }

            ta := TouchArea {
                clicked => {
                    Stage.card-clicked(idx);
                }

                changed has-hover => {
                    // Encode: enter -> idx, leave -> -(idx + 2) so the host
                    // can clear hover only when the leaving card is still
                    // the hovered one (event order between cards is not
                    // guaranteed).
                    Stage.card-hovered(ta.has-hover ? idx : -idx - 2);
                }
            }
        }

        // Status text when there are no background windows.
        if Stage.cards.length == 0: Rectangle {
            height: 60px;
            border-radius: Stage.corner;
            clip: true;

            drop-shadow-offset-y: 4px;
            drop-shadow-blur: 12px;
            drop-shadow-color: rgba(0, 0, 0, 0.55);

            Rectangle {
                background: rgba(28, 28, 33, Stage.card-opacity);
            }

            Rectangle {
                border-width: 1px;
                border-color: rgba(255, 255, 255, 0.35);
                border-radius: Stage.corner;
            }

            Text {
                text: Stage.status;
                color: white;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}
